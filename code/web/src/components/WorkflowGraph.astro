---
import { buildGraph, type GNode } from "../lib/workflow-graph.ts";
import "../styles/workflow-graph.css";

const { doc } = Astro.props;
const graph = buildGraph(doc);

const flow = graph.edges.filter((e) => e.kind === "flow");
const routes = graph.edges.filter((e) => e.kind === "route");
// Shortest spans take the inner lanes so wires nest without crossing.
const data = graph.edges
  .map((e, i) => ({ ...e, i }))
  .filter((e) => e.kind === "data");

const byId = new Map(graph.nodes.map((n) => [n.id, n]));
const span = (e: { from: string; to: string }) =>
  Math.abs((byId.get(e.to)?.row ?? 0) - (byId.get(e.from)?.row ?? 0));
data.sort((a, b) => span(a) - span(b));

const NODE_W = 210;
const ROW_H = 100;
const PAD = 14;
const LANE_W = 17;
const laneX = (lane: number) => PAD + 8 + lane * LANE_W;
const COL0 = PAD + 8 + data.length * LANE_W + 30;
const COL1 = COL0 + NODE_W + 130;

const nodeH = (n: GNode) => (n.sub.length > 0 ? 30 + n.sub.length * 13 : 28);
const x = (n: GNode) => (n.col === 0 ? COL0 : COL1);
const y = (n: GNode) => PAD + 6 + n.row * ROW_H;

const width = (graph.cols > 1 ? COL1 : COL0) + NODE_W + PAD + 6;
const height = PAD + 12 + (graph.rows - 1) * ROW_H + 72;

const facetColor: Record<string, string> = {
  signal: "var(--signal)",
  decision: "var(--decision)",
  review: "var(--review)",
  terminal: "var(--terminal)",
};
const accent = (n: GNode) => (n.facets.length > 0 ? facetColor[n.facets[0]] : "var(--faint)");
const R = 7; // wire corner radius
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  role="img"
  aria-label={`Process DAG for ${doc.name}`}
  class="wf-graph"
>
  <defs>
    <marker id="arrow" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0.6 L7.4,4 L0,7.4 z" fill="var(--dim)"></path>
    </marker>
    <marker id="arrow-route" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0.6 L7.4,4 L0,7.4 z" fill="var(--terminal)"></path>
    </marker>
  </defs>

  {/* typed data wires: orthogonal, one lane per wire, nested left of the spine */}
  {data.map((e, lane) => {
    const a = byId.get(e.from)!;
    const b = byId.get(e.to)!;
    const lx = laneX(data.length - 1 - lane);
    const y1 = y(a) + nodeH(a) - 9 - (lane % 3) * 5;
    const y2 = y(b) + 14 + (lane % 3) * 5;
    const midY = y1 + (y2 - y1) * (0.3 + (lane % 3) * 0.2);
    return (
      <g class="wire">
        <path
          d={`M ${x(a)} ${y1} H ${lx + R} Q ${lx} ${y1} ${lx} ${y1 + R} V ${y2 - R} Q ${lx} ${y2} ${lx + R} ${y2} H ${x(b) - 2}`}
          fill="none"
          stroke="var(--faint)"
          stroke-width="1"
          marker-end="url(#arrow)"
        />
        <rect x={lx - 5} y={midY - 7} width="10" height={7 + (e.label?.length ?? 0) * 5.4} fill="var(--bg)" transform={`rotate(90 ${lx} ${midY})`} opacity="0"></rect>
        <text x={lx} y={midY} class="wire-label" transform={`rotate(-90 ${lx} ${midY})`} text-anchor="middle" dy="3">
          {e.label}
        </text>
      </g>
    );
  })}

  {/* control-flow spine */}
  {flow.map((e) => {
    const a = byId.get(e.from)!;
    const b = byId.get(e.to)!;
    const cx = x(a) + NODE_W / 2;
    const y1 = y(a) + nodeH(a);
    const y2 = y(b) - 2;
    return (
      <g>
        <line x1={cx} y1={y1} x2={cx} y2={y2} stroke="var(--dim)" stroke-width="1.2" marker-end="url(#arrow)" />
        {e.label && (
          <text x={cx + 8} y={(y1 + y2) / 2 + 3.5} class="edge-label">{e.label}</text>
        )}
      </g>
    );
  })}

  {/* declared routes, elbowed to the terminal column */}
  {routes.map((e) => {
    const a = byId.get(e.from)!;
    const b = byId.get(e.to)!;
    const x1 = x(a) + NODE_W;
    const y1 = y(a) + nodeH(a) / 2;
    const x2 = x(b) - 2;
    const y2 = y(b) + nodeH(b) / 2;
    const mx = x1 + 52;
    return (
      <g>
        <path
          d={`M ${x1} ${y1} H ${mx - R} Q ${mx} ${y1} ${mx} ${y1 + R} V ${y2 - R} Q ${mx} ${y2} ${mx + R} ${y2} H ${x2}`}
          fill="none"
          stroke="var(--terminal)"
          stroke-width="1.2"
          marker-end="url(#arrow-route)"
        />
        <text x={mx + 8} y={y1 + (y2 - y1) / 2 + 3} class="edge-label route">{e.label}</text>
      </g>
    );
  })}

  {/* task nodes */}
  {graph.nodes.map((n) => {
    const h = nodeH(n);
    const terminalOnly = n.kind === "emit";
    return (
      <g>
        <rect
          x={x(n)}
          y={y(n)}
          width={NODE_W}
          height={h}
          rx={terminalOnly ? h / 2 : 2}
          fill="var(--panel-2)"
          stroke={terminalOnly ? "var(--terminal)" : "var(--line)"}
          stroke-width="1"
          stroke-dasharray={n.kind === "signal" ? "5 3" : undefined}
        />
        {!terminalOnly && n.kind !== "signal" && (
          <rect x={x(n)} y={y(n)} width="3" height={h} fill={accent(n)} />
        )}
        <text x={x(n) + (terminalOnly ? 18 : 12)} y={y(n) + 17.5} class="node-title">
          {n.label}
        </text>
        {n.facets.length > 0 && !terminalOnly && (
          <text x={x(n) + NODE_W - 9} y={y(n) + 17} text-anchor="end" class="facet-tag" fill={accent(n)}>
            {n.facets.join(" · ")}
          </text>
        )}
        {n.sub.map((line, i) => (
          <text x={x(n) + 12} y={y(n) + 30.5 + i * 13} class="node-sub">
            {line}
          </text>
        ))}
      </g>
    );
  })}
</svg>

<p class="wf-legend">
  {Object.entries(facetColor).map(([facet, color]) => (
    <span><span class="swatch" style={`background:${color}`}></span>{facet}</span>
  ))}
  <span class="sep">│</span>
  <span>─ control flow</span>
  <span style="color:var(--terminal)">─ declared route</span>
  <span>┄ typed handoff</span>
</p>

