---
const { repos } = Astro.props;
const yes = "✓";
const no = "—";
---

<table>
  <thead>
    <tr>
      <th>repo</th>
      <th>level</th>
      <th title="AGENTS.md · CONTRIBUTING.md · DESIGN.md">docs A·C·D</th>
      <th>.agents/</th>
      <th>agent workflows</th>
      <th>baseline</th>
    </tr>
  </thead>
  <tbody>
    {repos.map((repo: any) => (
      <tr>
        <td>
          {repo.url ? (
            <a href={repo.url} rel="noreferrer"><code>{repo.name}</code></a>
          ) : (
            <code>{repo.name}</code>
          )}{" "}
          {repo.signals.catalog && <span class="badge">catalog</span>}{" "}
          {["private", "local"].includes(repo.visibility) && (
            <span class="dim">({repo.visibility})</span>
          )}
        </td>
        <td>
          <span class="badge level">
            {repo.level} {repo.level_name}
          </span>
        </td>
        <td class="docs-cell">
          <span
            class:list={[{ dimmed: !(repo.signals.agents_md || repo.signals.claude_md) }]}
            title={repo.signals.agents_links_contributing
              ? "AGENTS.md references CONTRIBUTING.md"
              : "AGENTS.md"}
          >
            A{repo.signals.agents_links_contributing ? "@" : ""}
          </span>
          <span class:list={[{ dimmed: !repo.signals.contributing_md }]} title="CONTRIBUTING.md">C</span>
          <span class:list={[{ dimmed: !repo.signals.design_md }]} title="DESIGN.md">D</span>
        </td>
        <td>{repo.signals.dotagents_tree ? yes : no}</td>
        <td>
          {repo.signals.agent_workflows.length === 0 &&
            repo.signals.declared_workflows.length === 0 &&
            no}
          {repo.signals.agent_workflows.length > 0 && (
            <code>{repo.signals.agent_workflows.join(", ")}</code>
          )}
          {repo.signals.declared_workflows.length > 0 && (
            <div>
              <code>{repo.signals.declared_workflows.join(", ")}</code>{" "}
              <span class="dim">declared{repo.signals.governance ? " · governed" : ""}</span>
            </div>
          )}
        </td>
        <td>
          {repo.baseline.map((check: any) => (
            <span class="badge" class:list={[check.status]} title={check.note}>
              {check.rule}: {check.status}
            </span>
          ))}
          {/* Guarded: a report written before evidence backends existed has
              no `evidence_gate` at all. */}
          {repo.signals.evidence_gate && (
            <>
              <span
                class="badge"
                class:list={[repo.signals.evidence_gate.status === "met" ? "pass" : "fail"]}
                title={repo.signals.evidence_gate.evidence}
              >
                {repo.signals.evidence_gate.backend}:{" "}
                {repo.signals.evidence_gate.declared_only
                  ? "declared only"
                  : repo.signals.evidence_gate.status}
              </span>
              {repo.signals.evidence_gate.direct_pushes_blocked === false && (
                <span class="badge fail" title="No rule requires a pull request, so a commit can reach the default branch without passing any check (CICD-001.9.3)">
                  direct push
                </span>
              )}
              {(repo.signals.evidence_gate.bypass_actors ?? [])
                .filter((actor: any) => actor.mode === "always")
                .map((actor: any) => (
                  <span class="badge fail" title="Bypasses the ruleset unconditionally. A silent ruleset bypass is not a recorded break-glass path (CICD-001.7.4)">
                    bypass: {actor.who}
                  </span>
                ))}
              {repo.signals.evidence_gate.sample && (
                <span
                  class="badge"
                  class:list={[
                    repo.signals.evidence_gate.sample.gated ===
                    repo.signals.evidence_gate.sample.merged_prs
                      ? "pass"
                      : "",
                  ]}
                  title="Merged pull requests that carried a passing evidence check. Required and reporting are different facts."
                >
                  {repo.signals.evidence_gate.sample.gated}/
                  {repo.signals.evidence_gate.sample.merged_prs} merges gated
                </span>
              )}
            </>
          )}
        </td>
      </tr>
    ))}
  </tbody>
</table>
