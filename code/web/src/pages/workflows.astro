---
import { createHash } from "node:crypto";
import Base from "../layouts/Base.astro";
import WorkflowGraph from "../components/WorkflowGraph.astro";
import { loadWorkflows } from "../lib/server-data.ts";
import "../styles/workflows.css";

export const prerender = false;

const workflows = loadWorkflows();

const digest = (raw: string) =>
  createHash("sha256").update(raw).digest("hex").slice(0, 12);

// `${{ steps.plan.output }}` -> `steps.plan.output`
const ref = (value: unknown): string =>
  typeof value === "string" ? value.replace(/\$\{\{\s*/g, "").replace(/\s*\}\}/g, "") : String(value);

const triggerParts = (on: Record<string, any>): string[] => {
  const [event, config] = Object.entries(on)[0] ?? ["event", {}];
  const parts = [event as string];
  for (const [key, value] of Object.entries(config ?? {})) {
    parts.push(`${key} ${Array.isArray(value) ? value.join(", ") : value}`);
  }
  return parts;
};

const ifParts = (expr: string) => {
  const m = expr.match(/(.+?)\s*==\s*'([^']*)'/);
  return m ? { subject: ref(m[1]), value: m[2] } : { subject: ref(expr), value: "" };
};
---

<Base title="Agent workflows">
  <h1>Defined workflows</h1>
  <p class="dim">
    The catalog's <code>agent-workflow/v1</code> definitions, compiled to their
    process DAGs. Schema-validated in CI; no runtime executes them yet.
  </p>

  {
    workflows.map(({ file, raw, doc }) => (
      <section class="card">
        <header class="wf-head">
          <h2>{doc.name}</h2>
          <span class="digest">
            {file} · sha256:{digest(raw)}
          </span>
        </header>
        <p class="trigger-line">
          {triggerParts(doc.on).map((part, i) => (
            <>
              {i > 0 && <span class="tsep">·</span>}
              <span class:list={[i === 0 ? "tevent" : "tcond"]}>{part}</span>
            </>
          ))}
        </p>

        <WorkflowGraph doc={doc} />

        <ol class="steps">
          {doc.steps.map((step) => (
            <li>
              <div class="step-head">
                <code class="step-id">{step.id ?? `emit ${(step.emit as any)?.status ?? ""}`}</code>
                {step.agent && <span class="does">agent <code>{step.agent}</code></span>}
                {step.run && <span class="does">run <code>{step.run}</code></span>}
              </div>
              <div class="step-detail">
                {step.if && (
                  <span class="kv route-kv">
                    when <code>{ifParts(step.if).subject}</code> = <code>{ifParts(step.if).value}</code>
                  </span>
                )}
                {Object.entries(step.with ?? {}).map(([name, value]) => (
                  <span class="kv">
                    {name} ← <code>{ref(value)}</code>
                  </span>
                ))}
                {step["runs-on"] && (
                  <span class="kv">runs-on ← <code>{ref(step["runs-on"])}</code></span>
                )}
                {step["posts-to"] && (
                  <span class="kv">posts-to → <code>{ref(step["posts-to"])}</code></span>
                )}
                {step.reviewers && (
                  <span class="kv">reviewers <code>{step.reviewers.join(", ")}</code></span>
                )}
                {step.emit && (
                  <span class="kv emit-kv">
                    emit <span class="badge pass">{(step.emit as any).status}</span>
                    {(step.emit as any).summary && (
                      <span class="dim"> “{ref((step.emit as any).summary)}”</span>
                    )}
                  </span>
                )}
              </div>
            </li>
          ))}
        </ol>

        <details>
          <summary>yaml source</summary>
          <pre>{raw}</pre>
        </details>
      </section>
    ))
  }
</Base>

