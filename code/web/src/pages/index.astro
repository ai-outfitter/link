---
import Base from "../layouts/Base.astro";
import RepoTable from "../components/RepoTable.astro";
import report from "../data/report.json";
import "../styles/report.css";
---

<Base title="SDLC report">
  <h1>Organization SDLC report</h1>
  <p class="dim">
    Generated {report.generated_at} &middot; audited against governance baseline
    <code>{report.baseline.name}</code> (enforcement: {report.baseline.enforcement})
  </p>

  {
    report.orgs.map((org) => {
      const ranked = org.repos.filter((repo) => repo.active && repo.role !== "meta");
      const unranked = org.repos.filter((repo) => !repo.active || repo.role === "meta");
      const statusGlyph = { met: "✓", unmet: "✗", unknown: "?" };
      return (
        <section class="card">
          <h2 style="margin-top:0">
            {org.org}
            <span class="badge level">level {org.org_level} &middot; {org.org_level_name}</span>
            <span class="badge">{org.source_type === "folder" ? "local folder" : "github org"}</span>
          </h2>
          <p class="dim">
            {org.repos.length} repos scanned ({org.sampling_note}) at {org.scanned_at}
            <br />
            {org.ranking_note}
          </p>

          <ul class="milestones">
            {org.milestones.map((m) => (
              <li class:list={[m.status]}>
                <span class="glyph">{statusGlyph[m.status]}</span>
                <span class="mtitle">{m.title}</span>
                <span class="dim">{m.evidence}</span>
              </li>
            ))}
          </ul>

          {org.gaps.length > 0 && (
            <>
              <strong>Gaps</strong>
              <ul>
                {org.gaps.map((gap) => (
                  <li>{gap}</li>
                ))}
              </ul>
            </>
          )}

          <RepoTable repos={ranked} />

          {unranked.length > 0 && (
            <details class="inactive">
              <summary>
                {unranked.length} unranked {unranked.length === 1 ? "repo" : "repos"} (inactive
                &gt;7 days, or meta) — hidden
              </summary>
              <RepoTable repos={unranked} />
            </details>
          )}
        </section>
      );
    })
  }

  <h2>Evidence limits</h2>
  <ul class="dim">
    {report.evidence_limits.map((limit) => <li>{limit}</li>)}
  </ul>
</Base>

