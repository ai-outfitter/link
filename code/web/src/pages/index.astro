---
import Base from "../layouts/Base.astro";
import RepoTable from "../components/RepoTable.astro";
import { loadReport, loadSources } from "../lib/server-data.ts";
import "../styles/report.css";

export const prerender = false;

const report = loadReport();
const sources = loadSources();
---

<Base title="SDLC report">
  <h1>Organization SDLC report</h1>
  <p class="dim">
    Generated {report?.generated_at ?? "never"} &middot; audited against governance baseline
    <code>{report?.baseline.name}</code> (enforcement: {report?.baseline.enforcement})
  </p>

  <section class="sources-panel">
    <form id="add-source-form">
      <input
        id="source-target"
        name="target"
        placeholder="github org, or a local folder path (~/repos/ncrmro)"
        autocomplete="off"
      />
      <button type="submit">add source</button>
      <button type="button" id="rescan">rescan</button>
      <span id="scan-status" class="dim"></span>
    </form>
    <p class="dim registered">
      registered: {sources.length === 0 && <span>none (defaults only)</span>}
      {sources.map((source) => <code data-source={source.target}>{source.target}</code>)}
      &middot; <span>~/repos/ai-outfitter always included</span>
    </p>
  </section>
  <script src="../scripts/sources.ts"></script>

  {!report && (
    <section class="card">
      <h2 style="margin-top:0">No report yet</h2>
      <p>
        Nothing has been scanned on this machine. Run <code>link report &lt;org&gt;</code>, or add a
        source above and rescan. In a container, the report is read from the mounted working
        directory, so scan and serve with the same <code>-v "$PWD:/work"</code>.
      </p>
    </section>
  )}

  {
    (report?.orgs ?? []).map((org) => {
      const ranked = org.repos.filter((repo) => repo.active && repo.role !== "meta");
      const unranked = org.repos.filter((repo) => !repo.active || repo.role === "meta");
      const statusGlyph = { met: "✓", unmet: "✗", unknown: "?" };
      return (
        <section class="card">
          <h2 style="margin-top:0">
            {org.org}
            <span class="badge level">level {org.org_level} &middot; {org.org_level_name}</span>
            <span class="badge">
              {
                {
                  folder: "local folder",
                  "github-org": "github org",
                  "github-org+folder": "github org + local checkouts",
                }[org.source_type]
              }
            </span>
            {org.identity && org.identity !== org.org && (
              <span class="dim identity">{org.identity}</span>
            )}
          </h2>
          <p class="dim">
            {org.repos.length} repos scanned ({org.sampling_note}) at {org.scanned_at}
            <br />
            {org.ranking_note}
          </p>

          <ul class="milestones">
            {org.milestones.map((m) => (
              <li class:list={[m.status]}>
                <span class="glyph">{statusGlyph[m.status]}</span>
                <span class="mtitle">{m.title}</span>
                <span class="dim">{m.evidence}</span>
              </li>
            ))}
          </ul>

          {org.gaps.length > 0 && (
            <>
              <strong>Gaps</strong>
              <ul>
                {org.gaps.map((gap) => (
                  <li>{gap}</li>
                ))}
              </ul>
            </>
          )}

          <RepoTable repos={ranked} />

          {unranked.length > 0 && (
            <details class="inactive">
              <summary>
                {unranked.length} unranked {unranked.length === 1 ? "repo" : "repos"} (inactive
                &gt;7 days, or meta) — hidden
              </summary>
              <RepoTable repos={unranked} />
            </details>
          )}
        </section>
      );
    })
  }

  {report && (
    <>
      <h2>Evidence limits</h2>
      <ul class="dim">
        {report.evidence_limits.map((limit) => (
          <li>{limit}</li>
        ))}
      </ul>
    </>
  )}
</Base>

