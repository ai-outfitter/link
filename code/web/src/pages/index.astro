---
import Base from "../layouts/Base.astro";
import RepoTable from "../components/RepoTable.astro";
import { loadReport, loadSources } from "../lib/server-data.ts";
import "../styles/report.css";

export const prerender = false;

const report = loadReport();
const sources = loadSources();

const LEVEL_NAMES = [
  "none",
  "assisted",
  "delegated",
  "automated",
  "governed",
  "self-improving",
];

// Remediation instructions mark paths and file names with backticks. Escape
// first and promote after: the strings are authored constants today, but the
// report is data, and data is never trusted as markup.
const escapeHtml = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const inlineCode = (text: string) =>
  escapeHtml(text).replace(/`([^`]+)`/g, "<code>$1</code>");

// Group the plan into runs of consecutive steps that share a rung. The
// scanner already emitted them in priority order, so grouping consecutive
// runs keeps the ranks ascending down the page: the rung is what a reader
// scans for, and the numbering still says what to do first.
const planBands = (steps: any[]) => {
  const bands: { group: string; level: number | null; steps: any[] }[] = [];
  for (const step of steps) {
    const last = bands[bands.length - 1];
    if (last && last.group === step.group && last.level === step.blocks_level) last.steps.push(step);
    else bands.push({ group: step.group ?? "level", level: step.blocks_level, steps: [step] });
  }
  return bands;
};
---

<Base title="SDLC report">
  <h1>Organization SDLC report</h1>
  <p class="dim">
    Generated {report?.generated_at ?? "never"} &middot; audited against governance baseline{" "}
    <a href="/baseline"><code>{report?.baseline.name}</code></a> (enforcement: {
      report?.baseline.enforcement
    })
  </p>

  <section class="sources-panel">
    <form id="add-source-form">
      <input
        id="source-target"
        name="target"
        placeholder="github org, or a local folder path (~/repos/acme)"
        autocomplete="off"
      />
      <button type="submit">add source</button>
      <button type="button" id="rescan">rescan</button>
      <span id="scan-status" class="dim"></span>
    </form>
    <p class="dim registered">
      registered: {sources.length === 0 && <span>none</span>}
      {sources.map((source) => <code data-source={source.target}>{source.target}</code>)}
    </p>
  </section>
  <script src="../scripts/sources.ts"></script>

  {!report && (
    <section class="card">
      <h2 style="margin-top:0">No report yet</h2>
      <p>
        Nothing has been scanned on this machine. Run <code>link report &lt;org&gt;</code>, or add a
        source above and rescan. In a container, the report is read from the mounted working
        directory, so scan and serve with the same <code>-v "$PWD:/work"</code>.
      </p>
    </section>
  )}

  {
    (report?.orgs ?? []).map((org) => {
      const ranked = org.repos.filter((repo) => repo.active && repo.role !== "meta");
      const unranked = org.repos.filter((repo) => !repo.active || repo.role === "meta");
      const statusGlyph = { met: "✓", unmet: "✗", unknown: "?" };
      return (
        <section class="card">
          <h2 style="margin-top:0">
            {org.org}
            <span class="badge level">level {org.org_level} &middot; {org.org_level_name}</span>
            <span class="badge">
              {
                {
                  folder: "local folder",
                  "github-org": "github org",
                  "github-repo": "named repos only",
                  "github-org+github-repo": "github org + named repos",
                  "github-org+folder": "github org + local checkouts",
                  "github-repo+folder": "named repos + local checkouts",
                  "github-org+github-repo+folder": "github org + named repos + local checkouts",
                }[org.source_type] ?? org.source_type
              }
            </span>
            {org.identity && org.identity !== org.org && (
              <span class="dim identity">{org.identity}</span>
            )}
          </h2>
          <p class="dim">
            {org.repos.length} repos scanned ({org.sampling_note}) at {org.scanned_at}
            <br />
            {org.ranking_note}
            {org.dotagents_repo && (
              <>
                <br />
                catalog:{" "}
                {org.dotagents_url ? (
                  <a href={org.dotagents_url} rel="noreferrer">
                    <code>{org.dotagents_repo}</code>
                  </a>
                ) : (
                  <code>{org.dotagents_repo}</code>
                )}
              </>
            )}
          </p>

          <ul class="milestones">
            {org.milestones.map((m) => (
              <li class:list={[m.status]}>
                <span class="glyph">{statusGlyph[m.status]}</span>
                <span class="rung" title={m.level ? `gates level ${m.level}` : "gates the whole ramp"}>
                  {m.level ? `L${m.level}` : "—"}
                </span>
                <span class="mtitle">{m.title}</span>
                <span class="dim">{m.evidence}</span>
              </li>
            ))}
          </ul>

          {(org.next_steps ?? []).length > 0 && (
            <section class="plan">
              <h3>
                What to do next
                <span class="dim">
                  by the rung each step reaches; level {org.org_level + 1} ({
                    LEVEL_NAMES[org.org_level + 1] ?? "the next rung"
                  }) is the one in reach
                </span>
              </h3>
              {planBands(org.next_steps).map((band) => (
                <section class:list={["band", band.group, { reach: band.level === org.org_level + 1 }]}>
                  <h4>
                    {band.group === "foundation" && "Before the ramp"}
                    {band.group === "level" && `Level ${band.level} · ${LEVEL_NAMES[band.level]}`}
                    {band.group === "hygiene" && "Baseline hygiene"}
                    {band.level === org.org_level + 1 && <span class="badge level">next rung</span>}
                    {band.group === "foundation" && (
                      <span class="badge">blocks every rung</span>
                    )}
                  </h4>
                  <ol start={band.steps[0].rank}>
                    {band.steps.map((step) => (
                      <li>
                        <div class="step-title">{step.title}</div>
                        <p class="dim why">{step.unblocks}</p>
                        <ol class="how">
                          {step.how.map((instruction) => (
                            <li set:html={inlineCode(instruction)} />
                          ))}
                        </ol>
                        {step.repos.length > 0 && (
                          <p class="dim targets">
                            <span>where:</span>
                            {step.repos.map((repo) => (
                              <code>{repo}</code>
                            ))}
                          </p>
                        )}
                      </li>
                    ))}
                  </ol>
                </section>
              ))}
            </section>
          )}

          {(org.next_steps ?? []).length === 0 && org.gaps.length > 0 && (
            <>
              <strong>Gaps</strong>
              <ul>
                {org.gaps.map((gap) => (
                  <li>{gap}</li>
                ))}
              </ul>
            </>
          )}

          <RepoTable repos={ranked} />

          {unranked.length > 0 && (
            <details class="inactive">
              <summary>
                {unranked.length} unranked {unranked.length === 1 ? "repo" : "repos"} (inactive
                &gt;7 days, or meta) — hidden
              </summary>
              <RepoTable repos={unranked} />
            </details>
          )}
        </section>
      );
    })
  }

  {report && (
    <>
      <h2>Evidence limits</h2>
      <ul class="dim">
        {report.evidence_limits.map((limit) => (
          <li>{limit}</li>
        ))}
      </ul>
    </>
  )}
</Base>

