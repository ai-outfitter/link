---
import Base from "../layouts/Base.astro";
import RepoTable from "../components/RepoTable.astro";
import report from "../data/report.json";
---

<Base title="SDLC report">
  <h1>Organization SDLC report</h1>
  <p class="dim">
    Generated {report.generated_at} &middot; audited against governance baseline
    <code>{report.baseline.name}</code> (enforcement: {report.baseline.enforcement})
  </p>

  {
    report.orgs.map((org) => {
      const active = org.repos.filter((repo) => repo.active);
      const inactive = org.repos.filter((repo) => !repo.active);
      return (
        <section class="card">
          <h2 style="margin-top:0">
            {org.org}
            <span class="badge level">level {org.org_level} &middot; {org.org_level_name}</span>
          </h2>
          <p class="dim">
            {org.repos.length} repos scanned ({org.sampling_note}) at {org.scanned_at}
            <br />
            {org.ranking_note}
          </p>

          {org.gaps.length > 0 && (
            <>
              <strong>Gaps</strong>
              <ul>
                {org.gaps.map((gap) => (
                  <li>{gap}</li>
                ))}
              </ul>
            </>
          )}

          <RepoTable repos={active} />

          {inactive.length > 0 && (
            <details class="inactive">
              <summary>
                {inactive.length} inactive {inactive.length === 1 ? "repo" : "repos"} (no push in 7
                days) — hidden, not ranked
              </summary>
              <RepoTable repos={inactive} />
            </details>
          )}
        </section>
      );
    })
  }

  <h2>Evidence limits</h2>
  <ul class="dim">
    {report.evidence_limits.map((limit) => <li>{limit}</li>)}
  </ul>
</Base>

<style>
  details.inactive { margin-top: 1rem; }
  details.inactive summary {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.4rem 0;
    border-top: 1px solid var(--hairline);
  }
  details.inactive table { opacity: 0.65; }
</style>
