---
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/instrument-serif/400.css";
import "../styles/global.css";
import { requestToken } from "../lib/security.ts";

const { title } = Astro.props;
const path = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="link-request-token" content={requestToken()} />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      <span class="wordmark">link</span>
      <span class="rule"></span>
      <a href="/" class:list={[{ active: path === "/" }]}>Report</a>
      <a href="/workflows" class:list={[{ active: path.startsWith("/workflows") }]}>Workflows</a>
      <a href="/baseline" class:list={[{ active: path.startsWith("/baseline") }]}>Baseline</a>
    </nav>
    <main>
      <slot />
    </main>
    <footer>drawn from frozen definitions &middot; read-only surface</footer>
  </body>
</html>
